<configuration>
  <appender name="FILE" class="ch.qos.logback.core.FileAppender">
    <file>${poc.logfile}</file><append>false</append>
    <encoder><pattern>%date{ISO8601,UTC} %-5level %logger - %msg%n</pattern></encoder>
  </appender>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%level %logger{35} - %msg%n</pattern></encoder>
  </appender>
  <logger name="org.springframework.web" level="INFO"/>
  <logger name="com.OrderManagement" level="DEBUG"/>
  <root level="INFO"><appender-ref ref="FILE"/><appender-ref ref="CONSOLE"/></root>
</configuration>
